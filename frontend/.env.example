# Frontend environment variables
# ─────────────────────────────────────────────
# Copy this file to .env.local for local development.
# .env.local is gitignored — never commit it.
#
# Vite exposes variables prefixed with VITE_ to the browser bundle.
# Do NOT put secrets in frontend env vars — they are public.

# ── API base URL ──────────────────────────────

# The base URL of the Cloudflare Worker backend.
# In development the Vite proxy forwards /api → http://localhost:8787 automatically,
# so this variable is only needed if you deploy the frontend separately from the worker
# (e.g. Cloudflare Pages pointing at a deployed worker URL).
# Leave blank for local dev — the vite.config.js proxy handles it.
VITE_API_BASE_URL=
